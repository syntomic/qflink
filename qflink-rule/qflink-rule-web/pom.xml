<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>cn.syntomic.qflink</groupId>
		<artifactId>qflink-rule</artifactId>
		<version>${revision}</version>
	</parent>

	<artifactId>qflink-rule-web</artifactId>
	<name>QFlink : Rule : Web</name>
	<packaging>jar</packaging>

	<properties>
		<jackson.version>2.18.2</jackson.version>
	</properties>

	<dependencies>
		<!-- ! the console is a plain java process, it must not need flink or a cluster to start -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>${jackson.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.kafka</groupId>
			<artifactId>kafka-clients</artifactId>
			<version>${kafka.version}</version>
			<scope>compile</scope>
		</dependency>
		<!-- the same evaluator the rule engine uses, so an expression is checked before it is published -->
		<dependency>
			<groupId>com.googlecode.aviator</groupId>
			<artifactId>aviator</artifactId>
			<scope>compile</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<configuration>
							<artifactSet>
								<!-- ! the console is a standalone process, not a job a cluster provides
								     the logging for, so slf4j stays in the jar, unlike the parent's list -->
								<excludes combine.self="override">
									<exclude>org.apache.flink:*</exclude>
									<exclude>com.google.code.findbugs:jsr305</exclude>
									<exclude>log4j:*</exclude>
									<exclude>junit:*</exclude>
									<exclude>org.apache.logging.log4j:*</exclude>
								</excludes>
							</artifactSet>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>cn.syntomic.qflink.web.WebServer</mainClass>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
